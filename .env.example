
POSTGRES_ADMIN_USER=quiz_admin
POSTGRES_ADMIN_PASSWORD=change_this_admin_password_in_production

# Nome del database
POSTGRES_DB=quiz_db


APP_DB_USER=quiz_app_user
APP_DB_PASSWORD=change_this_app_password_in_production

# Username dell'amministratore dell'applicazione
ADMIN_USERNAME=your_admin_username

# JWT signing secret - must be a random string of at least 32 characters
SECRET_KEY=replace_with_a_random_32+_character_secret

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://upquiz.fabiotommaselli.net

# Only trust X-Forwarded-For when running behind a reverse proxy that sets it
TRUST_PROXY_HEADERS=false
